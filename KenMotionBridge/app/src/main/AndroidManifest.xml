<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Necessária para requestNetwork (amarrar o MQTT à rede celular — split de rotas) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Serviço fica em foreground para sobreviver à tela apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Necessário em Android 13+ para exibir a notificação do foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Visibilidade de pacotes (Android 11+/targetSdk 34): permite resolver e bindar
         o serviço do RobotSDK (CSJBot) por ação/componente, mesmo estando em outro app.
         QUERY_ALL_PACKAGES: neste tablet o app do RobotSDK NÃO é o com.csjbot.robotsdk.ten
         esperado (só com.csjbot.diningcar visto) — a ponte precisa VARRER os pacotes
         com.csjbot.*/com.slamtec.* atrás do RobotSdkService real. Ferramenta interna
         de operação, sem distribuição na Play Store. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Best-effort para encerrar processos em segundo plano de outros apps (não
         força stop de kiosk em foreground — Android limita isso a system/root). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <queries>
        <package android:name="com.csjbot.robotsdk.ten" />
        <package android:name="com.csjbot.diningcar" />
        <intent>
            <action android:name="com.csjbot.robotsdkservice.startservice" />
        </intent>
        <intent>
            <action android:name="com.slamtec.aidl.RobotSdkService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KenMotionBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AppManagerActivity"
            android:exported="false"
            android:label="Apps / Encerrar"
            android:parentActivityName=".MainActivity" />

        <!-- Processo PRINCIPAL: chassi (amarra à rede do robô 192.168.99.x) -->
        <service
            android:name=".service.RobotBridgeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Processo :mqtt ISOLADO: broker (amarra à rede de internet do tethering/hotspot).
             Cada processo tem seu próprio bindProcessToNetwork — resolve o dual-homing. -->
        <service
            android:name=".service.MqttBridgeService"
            android:process=":mqtt"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Callback do RobotSDK (contrato oficial, ver docs/PROTOCOLO_ROBOTSDK.md):
             após connectToSDK(), o app do fabricante binda AQUI (ação com.csjbot.sdk.connect)
             e entrega eventos via ISdkAppToAar.sdkAppMsgToAar(json). Precisa ser exported. -->
        <service
            android:name=".sdk.SdkCallbackService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.csjbot.sdk.connect" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
