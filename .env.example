# Broker MQTT (HiveMQ Cloud) — usado pelo app web (Vite).
# NO NAVEGADOR use WebSocket Secure (porta 8884, caminho /mqtt). NÃO use ssl://...:8883.
# Copie para .env e preencha com as MESMAS credenciais usadas pela ponte KenMotionBridge.

VITE_MQTT_URL=wss://SEU-CLUSTER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USER=ken-robot
VITE_MQTT_PASS=TROQUE-ME

# Opcionais (já têm default igual ao da ponte):
# VITE_MQTT_TOPIC_CMD=ken/motion/cmd
# VITE_MQTT_TOPIC_FEEDBACK=ken/motion/feedback
# VITE_MQTT_TOPIC_TELEMETRY=ken/sensors/telemetry
