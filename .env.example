# Configuração do transporte MQTT da UI (app web).
# Copie para `.env` e preencha com os dados do SEU broker (o MESMO usado pelo
# KenMotionBridge em KenMotionBridge/app/src/main/assets/bridge_config.json).
#
#   cp .env.example .env
#
# Observações:
# - No browser/WebView o MQTT roda sobre WebSocket: use wss://HOST:8884/mqtt
#   (porta WebSocket/TLS do HiveMQ Cloud). A ponte Android usa ssl://HOST:8883.
# - Variáveis Vite precisam do prefixo VITE_ para chegarem ao código do cliente.
# - NÃO comite o seu `.env` com credenciais reais (apenas este .env.example).

# URL do broker MQTT sobre WebSocket (TLS).
VITE_MQTT_URL=wss://SEU-CLUSTER.s1.eu.hivemq.cloud:8884/mqtt

# Credenciais do broker.
VITE_MQTT_USERNAME=ken-robot
VITE_MQTT_PASSWORD=TROQUE-ME

# Tópicos (devem bater com os do bridge_config.json). Opcionais — já têm default.
VITE_MQTT_TOPIC_CMD=ken/motion/cmd
VITE_MQTT_TOPIC_FEEDBACK=ken/motion/feedback
VITE_MQTT_TOPIC_TELEMETRY=ken/sensors/telemetry
